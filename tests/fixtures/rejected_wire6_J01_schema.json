  "$defs": {
    "JudgeClaim_c1": {
      "type": "object",
      "title": "JudgeOrdinaryClaimResult",
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "ordinary_coverage"
          ]
        },
        "result": {
          "type": "string",
          "enum": [
            "met",
            "missing",
            "contradicted"
          ]
        },
        "parts": {
          "type": "array",
          "description": "Concatenate texts to the complete original claim exactly. Positive/conflicting observations require actual answer anchors. Conflict precedes omission then positive; the explicit result must agree.\n\n{maxItems: 164}",
          "items": {
            "type": "object",
            "properties": {
              "text": {
                "type": "string",
                "description": "{minLength: 1, maxLength: 164}"
              },
              "observation": {
                "type": "string",
                "enum": [
                  "explicit",
                  "necessary_implication",
                  "omitted",
                  "conflicting"
                ]
              },
              "answer_anchors": {
                "type": "array",
                "description": "One exact contiguous quotation per named trusted text, in trusted order.\n\n{maxItems: 4}",
                "items": {
                  "type": "object",
                  "properties": {
                    "statement_id": {
                      "type": "string",
                      "enum": [
                        "s1",
                        "s2",
                        "s3",
                        "s4"
                      ]
                    },
                    "quote": {
                      "type": "string",
                      "description": "An exact contiguous quotation from the original text selected by its ID.\n\n{minLength: 1}"
                    }
                  },
                  "additionalProperties": false,
                  "required": [
                    "statement_id",
                    "quote"
                  ]
                }
              },
              "basis": {
                "type": "string",
                "description": "{minLength: 1, maxLength: 360, pattern: \\S}"
              }
            },
            "additionalProperties": false,
            "required": [
              "text",
              "observation",
              "answer_anchors",
              "basis"
            ]
          },
          "minItems": 1
        }
      },
      "additionalProperties": false,
      "required": [
        "kind",
        "result",
        "parts"
      ]
    },
